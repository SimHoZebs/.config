# Ignore everything by default
*

# Explicitly include tracked directories
!.gitignore
!git/
!git/**
!lazygit/
!lazygit/**
!nvim/
!nvim/**
!opencode/
!opencode/**
!tasks/
!tasks/**
!vars/
!vars/**
!tmux/
!tmux/**
!wezterm/
!wezterm/**

# Explicitly include tracked files
!.bashrc
!.profile
!bootstrap.sh
!install.sh
!windows-setup.ps1
!gitmux.conf
!package.json
!playbook.yml
!windows-playbook.yml
!requirements.yml
!README.md

# Exclude specific items within included directories
tmux/plugins/
opencode/*-key
