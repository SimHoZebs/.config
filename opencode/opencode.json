{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "model": "opencode-go/muse-spark-1.3-contributor"
    }
  },
  "experimental": {
    "subagent_depth": 3
  },
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ],
        "disabled": false
      },
      "grafana": {
        "type": "local",
        "command": ["/home/simho/.config/opencode/bin/mcp-grafana"],
        "environment": {
          "GRAFANA_URL": "https://grafana.home.simho.xyz",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:./grafana-key}"
        },
        "disabled": false
      }
    }
  }
}
