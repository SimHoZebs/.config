{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "edit": "ask",
    "bash": {
      "cat *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "docker ps *": "allow",
      "docker network ls *": "allow",
      "docker inspect *": "allow",
      "docker images *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git branch": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "whoami": "allow",
      "date": "allow",
      "node -v": "allow",
      "npm -v": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "pip list *": "allow",
      "npm list *": "allow",
      "go doc": "allow",
      "rg *": "allow"
    }
  },
  "mcp": {
    "notion_mcp": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "environment": {
        "NOTION_TOKEN": "{file:./notion-key}"
      },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--config", "/home/simho/.config/opencode/playwright-mcp.json"],
      "enabled": true
    },
    "grafana": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana", "-t", "stdio"],
      "environment": {
        "GRAFANA_URL": "https://grafana.home.simho.xyz",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:./grafana-key}"
      },
      "enabled": true
    }
  }
}
