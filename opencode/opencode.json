{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "cat *": "allow",
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "docker ps *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git branch": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "whoami": "allow",
      "date": "allow",
      "node -v": "allow",
      "npm -v": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "pip list *": "allow",
      "npm list *": "allow",
      "go doc": "allow",
      "docker inspect *": "allow",
      "docker images *": "allow"
    }
  },
  "mcp": {
    "notion_mcp": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "environment": {
        "NOTION_TOKEN": "{file:./notion-key}"
      },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
