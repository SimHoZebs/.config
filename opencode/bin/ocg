#!/usr/bin/env python3
"""ocg - search OpenCode chat history and resume a session.

Usage:
  ocg [query]                 search chat messages, most relevant first
  ocg -s|--sessions [query]   pick a session by project, title, and date

Results are ranked by relevance, then recency. Relevance scores each message's
text with BM25, which favors rare words and repeated mentions, gives extra
credit when the words appear together as typed, and adds a smaller score when
query words appear in the session's title. Every word must appear in the
message or in its session's title; "quoted words" must appear as an exact
phrase; !word excludes messages containing word. A word with an uppercase
letter matches case-sensitively. Sessions launched by an agent as subagents
are not searched or listed.

Each result shows who wrote a message, when, and in which session, with the
matching text below. The preview opens the conversation at that message.
Keys: Enter resumes the session in its directory, Ctrl-Y prints its id,
Ctrl-/ toggles the preview, and Ctrl-R refreshes results while older sessions
are still loading.

The OpenCode V2 database is opened read-only. Each session's messages are
cached under $XDG_CACHE_HOME/opencode-search and read again only after that
session changes. Before the picker opens, the OCG_EAGER newest uncached
sessions (default 50) are cached; the rest load in the background at low CPU
priority, OCG_BATCH at a time (default 10) with OCG_PAUSE seconds between
batches (default 0.25). Requires fzf 0.56 or newer.
"""

import hashlib
import json
import math
import os
import re
import shlex
import shutil
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from urllib.request import pathname2url

SELF = os.path.realpath(__file__)
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
SAFE_ID = re.compile(r"^[A-Za-z0-9_-]+$")
LEGACY_CACHE_FILES = ("messages.tsv", "messages.stamp", "build.lock")
STALE_TEMPORARY_SECONDS = 86_400
MINIMUM_FZF = (0, 56)
PREVIEW_LINES = 600
MESSAGE_LINES = 200
CONTEXT_LINES = 4
PRETTY_JSON_BYTES = 200_000
RESULTS = 500
EXCERPT_LEAD = 60
EXCERPT_LENGTH = 400
TITLE_WEIGHT = 0.5
COMMON_TITLE_SHARE = 0.1
QUERY_TOKEN = re.compile(r'"([^"]*)"?|(\S+)')

CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
WHITESPACE = re.compile(r"\s+")
ANSI = re.compile(r"(\x1b\[[0-9;]*m)")
INLINE = re.compile(r"(`[^`\n]+`)|(\*\*[^*\n]+\*\*)|(\[([^\]\n]+)\]\(([^)\s]+)\))")
FENCE = re.compile(r"^\s*(```|~~~)\s*([\w+-]*)")
HEADING = re.compile(r"^(#{1,6})\s+(.*)$")
RULE = re.compile(r"^\s*([-*_])(\s*\1){2,}\s*$")
QUOTE = re.compile(r"^\s*>\s?(.*)$")
BULLET = re.compile(r"^(\s*)[-*+]\s+(.*)$")
TABLE_SEPARATOR = re.compile(r"^\s*\|?[\s:|-]+\|?\s*$")
JSON_KEY = re.compile(r'^(\s*)("(?:[^"\\]|\\.)*")(\s*:)')

DIM, UNDIM = "\033[2m", "\033[22m"
BOLD = "\033[1m"
SPEAKERS = {
    "user": ("you", "1;36"),
    "assistant": ("assistant", "1;32"),
}

SESSIONS_SQL = """
WITH activity AS (
  SELECT session_id, max(time_updated) AS last, count(*) AS messages
  FROM session_message
  GROUP BY session_id
)
SELECT s.id, s.directory, COALESCE(project.name, ''), COALESCE(s.title, ''),
       activity.last, activity.messages
FROM session_v2 AS s
JOIN activity ON activity.session_id = s.id
LEFT JOIN project ON project.id = s.project_id
WHERE s.parent_id IS NULL AND s.time_archived IS NULL
ORDER BY activity.last DESC, s.id
"""

MESSAGES_SQL = """
SELECT sm.session_id, sm.seq, sm.time_created, sm.type,
       CASE sm.type
         WHEN 'user' THEN json_extract(sm.data, '$.text')
         ELSE (
           SELECT group_concat(json_extract(part.value, '$.text'), char(10) || char(10))
           FROM json_each(sm.data, '$.content') AS part
           WHERE json_extract(part.value, '$.type') = 'text'
             AND COALESCE(json_extract(part.value, '$.synthetic'), 0) = 0
         )
       END
FROM session_message AS sm
WHERE sm.session_id IN ({}) AND sm.type IN ('user', 'assistant')
ORDER BY sm.session_id, sm.seq
"""

SESSION_SQL = """
SELECT s.directory, COALESCE(s.title, ''), COALESCE(project.name, '')
FROM session_v2 AS s
LEFT JOIN project ON project.id = s.project_id
WHERE s.id = ?
"""


class Session:
    __slots__ = ("id", "directory", "project", "title", "last", "messages")

    def __init__(self, row):
        self.id, self.directory, self.project, self.title, self.last, self.messages = row

    def name(self):
        return project_name(self.project, self.directory)

    def fields(self, seq=""):
        return f"{self.id}\t{clean(self.directory)}\t{seq}\t"


class Chat:
    __slots__ = ("id", "cache_name", "last", "directory", "project", "title")

    def __init__(self, session_id, cache_name, last, directory, project, title):
        self.id, self.cache_name, self.last = session_id, cache_name, int(last)
        self.directory, self.project, self.title = directory, project, title

    def label(self):
        return f"{project_name(self.project, self.directory)} {self.title}"


def die(message):
    print(f"ocg: {message}", file=sys.stderr)
    sys.exit(1)


def clean(text):
    return WHITESPACE.sub(" ", CONTROL.sub(" ", text)).strip()


def project_name(project, directory):
    return project or os.path.basename(directory.rstrip("/")) or directory


def when(milliseconds, with_time=True):
    moment = datetime.fromtimestamp(milliseconds / 1000)
    return moment.strftime("%Y-%m-%d %H:%M" if with_time else "%Y-%m-%d")


def speaker(kind):
    label, color = SPEAKERS.get(kind, (kind, "1"))
    return f"\033[{color}m{label}\033[0m"


def setting(name, default, kind):
    value = os.environ.get(name, "")
    if not value:
        return default
    try:
        number = kind(value)
    except ValueError:
        die(f"{name} must be a number")
    if number < 0:
        die(f"{name} must not be negative")
    return number


def database_path():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return (os.environ.get("OPENCODE_DB_PATH") or os.environ.get("OPENCODE_DB")
            or os.path.join(data_home, "opencode", "opencode.db"))


def connect():
    path = database_path()
    if not os.path.isfile(path):
        die(f"opencode db not found at {path}")
    real = os.path.realpath(path)
    try:
        db = sqlite3.connect(f"file:{pathname2url(real)}?mode=ro", uri=True)
        db.execute("PRAGMA query_only = ON")
        tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    except sqlite3.Error as error:
        die(f"cannot read {path}: {error}")
    if not {"session_v2", "session_message"} <= tables:
        die(f"{path} has no OpenCode V2 history; ocg requires OpenCode V2")
    try:
        db.execute("SELECT json_extract('{\"a\": 1}', '$.a')")
    except sqlite3.OperationalError:
        die(f"the SQLite used by {sys.executable} has no JSON support")
    return db, real


def load_sessions(db):
    return [Session(row) for row in db.execute(SESSIONS_SQL)]


def messages(db, session_ids):
    placeholders = ", ".join("?" for _ in session_ids)
    return db.execute(MESSAGES_SQL.format(placeholders), list(session_ids))


def extract(db, session_ids):
    found = {session_id: [] for session_id in session_ids}
    for session_id, seq, created, kind, text in messages(db, session_ids):
        if text and text.strip():
            found[session_id].append((str(seq), str(created), kind, clean(text)))
    return found


def private_directory(path):
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        die(f"refusing cache directory {path}: not a directory owned by you")
    os.chmod(path, 0o700)


class Cache:
    SUFFIX = ".tsv"

    def __init__(self, database):
        cache_home = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
        os.makedirs(cache_home, exist_ok=True)
        self.root = os.path.join(cache_home, "opencode-search")
        database_key = os.path.join(self.root, hashlib.sha256(database.encode()).hexdigest()[:16])
        self.directory = os.path.join(database_key, "sessions")
        self.index_path = os.path.join(database_key, "index.tsv")
        for path in (self.root, database_key, self.directory):
            private_directory(path)
        self.remove_legacy()
        self.names = {}
        for name in os.listdir(self.directory):
            if name.endswith(self.SUFFIX):
                self.names.setdefault(name.split(".", 1)[0], set()).add(name)

    def remove_legacy(self):
        directories = [self.root] + [
            os.path.join(self.root, name) for name in os.listdir(self.root) if name.isdigit()
        ]
        for directory in directories:
            for name in LEGACY_CACHE_FILES:
                try:
                    os.unlink(os.path.join(directory, name))
                except OSError:
                    pass
            if directory != self.root:
                try:
                    os.rmdir(directory)
                except OSError:
                    pass
        for name in os.listdir(self.directory):
            if name.endswith(".txt"):
                try:
                    os.unlink(os.path.join(self.directory, name))
                except OSError:
                    pass

    def name(self, session):
        return f"{session.id}.{session.last}-{session.messages}{self.SUFFIX}"

    def cached(self, session):
        return self.name(session) in self.names.get(session.id, ())

    def read_file(self, name):
        """Return (text, ascii_lowered_text, rows) for a cache file, as UTF-8 bytes.

        Each row is (seq, created, kind, start, end), where text[start:end] is the message.
        """
        try:
            fd = os.open(os.path.join(self.directory, name), os.O_RDONLY | NOFOLLOW)
        except OSError:
            return None
        with os.fdopen(fd, "rb") as stream:
            content = stream.read()
        rows = []
        offset = 0
        for line in content.split(b"\n"):
            end = offset + len(line)
            fields = line.split(b"\t", 3)
            if len(fields) == 4 and fields[1].isdigit():
                rows.append((fields[0].decode(), int(fields[1]), fields[2].decode(), end - len(fields[3]), end))
            offset = end + 1
        return content, content.lower(), rows

    def newest_name(self, session_id, wanted):
        names = self.names.get(session_id, set())
        if wanted in names:
            return wanted
        return max(names, key=lambda name: name.split(".", 1)[1], default=None)

    def write_atomic(self, path, text):
        directory = os.path.dirname(path)
        temporary = os.path.join(directory, f".{os.path.basename(path)}.{os.getpid()}.{os.urandom(4).hex()}.tmp")
        try:
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(text)
            os.replace(temporary, path)
            return True
        except OSError:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            return False

    def write_index(self, sessions):
        self.write_atomic(self.index_path, "".join(
            f"{s.id}\t{self.name(s)}\t{s.last}\t{clean(s.directory)}\t{clean(s.project)}\t{clean(s.title)}\n"
            for s in sessions if SAFE_ID.match(s.id)
        ))

    def read_index(self):
        try:
            fd = os.open(self.index_path, os.O_RDONLY | NOFOLLOW)
        except OSError:
            return []
        with os.fdopen(fd, encoding="utf-8", errors="replace") as stream:
            rows = [line.rstrip("\n").split("\t", 5) for line in stream]
        return [Chat(*row) for row in rows if len(row) == 6 and row[2].isdigit()]

    def write(self, session, rows):
        if not SAFE_ID.match(session.id):
            return
        final = self.name(session)
        if not self.write_atomic(os.path.join(self.directory, final), "".join("\t".join(row) + "\n" for row in rows)):
            return
        for stale in self.names.get(session.id, set()) - {final}:
            try:
                os.unlink(os.path.join(self.directory, stale))
            except OSError:
                pass
        self.names[session.id] = {final}

    def prune(self, sessions):
        keep = {self.name(session) for session in sessions}
        now = time.time()
        index_directory = os.path.dirname(self.index_path)
        for directory in (self.directory, index_directory):
            for name in os.listdir(directory):
                path = os.path.join(directory, name)
                try:
                    if directory == self.directory and name.endswith(self.SUFFIX) and name not in keep:
                        os.unlink(path)
                    elif name.endswith(".tmp") and now - os.lstat(path).st_mtime > STALE_TEMPORARY_SECONDS:
                        os.unlink(path)
                except OSError:
                    pass


def fill(db, cache, sessions, limit=None, throttle=False):
    """Cache uncached sessions newest first; stop after `limit` sessions when given.

    With `throttle`, pause before every batch: the picker has already cached the
    newest sessions, so background loading never needs to hurry.
    """
    batch_size = max(1, setting("OCG_BATCH", 10, int))
    pause = setting("OCG_PAUSE", 0.25, float) if throttle else 0
    pending = [session for session in sessions if not cache.cached(session)]
    if limit is not None:
        pending = pending[:limit]
    for start in range(0, len(pending), batch_size):
        batch = pending[start:start + batch_size]
        if pause:
            time.sleep(pause)
        found = extract(db, [session.id for session in batch])
        for session in batch:
            cache.write(session, found[session.id])


def load():
    db, database = connect()
    cache = Cache(database)
    sessions = load_sessions(db)
    cache.write_index(sessions)
    fill(db, cache, sessions, throttle=True)
    cache.prune(sessions)


def parse_query(query):
    required, excluded = [], []
    for match in QUERY_TOKEN.finditer(query or ""):
        phrase, word = match.group(1), match.group(2)
        if phrase is not None:
            if phrase.strip():
                required.append(phrase.strip())
        elif word.startswith("!"):
            if len(word) > 1:
                excluded.append(word[1:])
        else:
            required.append(word)
    return required, excluded


class Term:
    """A query word or phrase; uppercase letters make it case-sensitive, as in fzf.

    Matching runs on UTF-8 bytes. Case-insensitive ASCII terms compare against
    ASCII-lowered bytes, which is much faster than Unicode lowering; other
    case-insensitive terms fall back to Unicode lowering of the message.
    """
    __slots__ = ("needle", "mode")

    def __init__(self, text):
        if text != text.lower():
            self.mode, self.needle = "raw", text.encode()
        elif text.isascii():
            self.mode, self.needle = "ascii", text.encode()
        else:
            self.mode, self.needle = "unicode", text

    def haystack(self, raw, lowered):
        if self.mode == "raw":
            return raw
        if self.mode == "ascii":
            return lowered
        return raw.decode("utf-8", "replace").lower()

    def count(self, raw, lowered):
        return self.haystack(raw, lowered).count(self.needle)

    def within(self, raw, lowered):
        return self.needle in self.haystack(raw, lowered)


class Scorer:
    """BM25: rarer terms weigh more, repeats count with diminishing returns, long texts are normalized.

    Terms found in more than `common` of the documents get no weight, so words like "and"
    cannot decide a ranking on their own.
    """

    def __init__(self, terms, frequencies, count, average, k1=1.2, b=0.75, common=1.0):
        self.terms, self.k1, self.b = terms, k1, b
        self.average = average or 1
        self.weight = [
            0.0 if frequency > common * count else math.log(1 + (count - frequency + 0.5) / (frequency + 0.5))
            for frequency in frequencies
        ]

    def score(self, text, lowered):
        total = 0.0
        norm = self.k1 * (1 - self.b + self.b * len(text) / self.average)
        for term, weight in zip(self.terms, self.weight):
            tf = term.count(text, lowered)
            if tf:
                total += weight * tf * (self.k1 + 1) / (tf + norm)
        return total


def frequencies(terms, documents):
    counts = [0] * len(terms)
    for text, lowered in documents:
        for index, term in enumerate(terms):
            if term.within(text, lowered):
                counts[index] += 1
    return counts


def excerpt(raw, lowered, terms, phrase=None):
    """Start just before the typed phrase when present, else before the earliest matching term."""
    first = -1
    if phrase is not None and phrase.mode != "unicode":
        first = phrase.haystack(raw, lowered).find(phrase.needle)
    if first < 0:
        positions = [term.haystack(raw, lowered).find(term.needle) for term in terms if term.mode != "unicode"]
        first = min((position for position in positions if position >= 0), default=0)
    start = max(0, first - EXCERPT_LEAD)
    while start and start < len(raw) and raw[start] & 0xC0 == 0x80:
        start += 1
    if start:
        space = raw.find(b" ", start, first)
        start = space + 1 if space >= 0 else start
    snippet = raw[start:start + EXCERPT_LENGTH * 2].decode("utf-8", "ignore")[:EXCERPT_LENGTH]
    return ("… " if start else "") + snippet


def search(query, limit=RESULTS):
    words, unwanted = parse_query(query)
    required = [Term(word) for word in words]
    excluded = [Term(word) for word in unwanted]
    plain = [word for word in words if " " not in word]
    extra = [Term(" ".join(plain))] if len(plain) > 1 else []
    scoring = required + extra
    highlight = highlighter(" ".join(f'"{word}"' for word in words))

    cache = Cache(os.path.realpath(database_path()))
    chats = cache.read_index()
    labels = {}
    for chat in chats:
        label = chat.label().encode()
        labels[chat.id] = (label, label.lower())
    titles = Scorer(required, frequencies(required, labels.values()), len(labels),
                    sum(len(label) for label, _ in labels.values()) / max(1, len(labels)), b=0, common=COMMON_TITLE_SHARE)

    counts = [0] * len(scoring)
    total_length = documents = 0
    candidates = []
    for chat in chats:
        name = cache.newest_name(chat.id, chat.cache_name)
        content = cache.read_file(name) if name else None
        if content is None:
            continue
        whole, whole_lowered, rows = content
        documents += len(rows)
        total_length += sum(end - start for _, _, _, start, end in rows)
        label, label_lowered = labels[chat.id]
        in_file = [term.within(whole, whole_lowered) for term in scoring]
        in_title = [term.within(label, label_lowered) for term in required]
        eligible = all(found or titled for found, titled in zip(in_file, in_title))
        if not eligible and not any(in_file):
            continue
        check_excluded = [term for term in excluded if term.within(whole, whole_lowered)]
        for seq, created, kind, start, end in rows:
            raw, lowered = whole[start:end], whole_lowered[start:end]
            present = [found and term.within(raw, lowered) for term, found in zip(scoring, in_file)]
            for index, found in enumerate(present):
                if found:
                    counts[index] += 1
            if not eligible or not all(found or titled for found, titled in zip(present, in_title)):
                continue
            if any(term.within(raw, lowered) for term in check_excluded):
                continue
            candidates.append((chat, seq, created, kind, raw, lowered))

    scorer = Scorer(scoring, counts, max(1, documents), total_length / max(1, documents))
    title_score = {chat.id: TITLE_WEIGHT * titles.score(*labels[chat.id]) for chat in chats}
    ranked = sorted(
        candidates,
        key=lambda row: (-(scorer.score(row[4], row[5]) + title_score[row[0].id]), -row[2], -row[0].last),
    )

    out = []
    for chat, seq, created, kind, raw, lowered in ranked[:limit]:
        header = (f"{DIM}{when(created)}{UNDIM}  {speaker(kind)}  {DIM}·{UNDIM} "
                  f"{clean(project_name(chat.project, chat.directory))} {DIM}·{UNDIM} {chat.title or 'untitled'}")
        body = highlight(excerpt(raw, lowered, required, extra[0] if extra else None))
        out.append(f"{chat.id}\t{chat.directory}\t{seq}\t{header}\n{body}\0")
    sys.stdout.buffer.write("".join(out).encode("utf-8", "replace"))


def status():
    cache = Cache(os.path.realpath(database_path()))
    chats = cache.read_index()
    waiting = sum(1 for chat in chats if chat.cache_name not in cache.names.get(chat.id, ()))
    base = "Enter resume · Ctrl-Y print id · Ctrl-/ preview · ranked by relevance, then recency"
    print(f"{base} · {waiting} older chat{'s' if waiting != 1 else ''} loading, Ctrl-R refreshes" if waiting else base)


def session_items(sessions):
    items = []
    for session in sessions:
        label = f"{DIM}{when(session.last, with_time=False)}{UNDIM}  {BOLD}{clean(session.name())}{UNDIM}"
        items.append(f"{session.fields()}{label}  {clean(session.title or 'untitled')}\0")
    return "".join(items)


def query_terms(query):
    return parse_query(query)[0]


def highlighter(query):
    terms = sorted(query_terms(query), key=len, reverse=True)
    if not terms:
        return lambda line: line
    pattern = re.compile("|".join(re.escape(term) for term in terms), re.IGNORECASE)

    def highlight(line):
        parts = ANSI.split(line)
        for index in range(0, len(parts), 2):
            parts[index] = pattern.sub(lambda match: f"\033[7m{match.group(0)}\033[27m", parts[index])
        return "".join(parts)
    return highlight


def match_line(body, terms):
    plain = [ANSI.sub("", line).lower() for line in body]
    lowered = [term.lower() for term in terms]
    for position, line in enumerate(plain):
        if all(term in line for term in lowered):
            return position
    longest = max(lowered, key=len)
    return next((position for position, line in enumerate(plain) if longest in line), 0)


def inline(text):
    def styled(match):
        if match.group(1):
            return f"\033[33m{match.group(1)[1:-1]}\033[39m"
        if match.group(2):
            return f"{BOLD}{match.group(2)[2:-2]}{UNDIM}"
        return f"\033[4m{match.group(4)}\033[24m {DIM}({match.group(5)}){UNDIM}"
    return INLINE.sub(styled, text)


def pretty_json(text):
    candidate = text.strip()
    if not candidate or candidate[0] not in "{[" or len(candidate) > PRETTY_JSON_BYTES:
        return None
    try:
        value = json.loads(candidate)
    except ValueError:
        return None
    if not isinstance(value, (dict, list)):
        return None
    lines = json.dumps(value, indent=2, ensure_ascii=False).split("\n")
    return [JSON_KEY.sub(lambda match: f"{match.group(1)}\033[36m{match.group(2)}\033[39m{match.group(3)}", line)
            for line in lines]


def code_block(lines, language):
    body = pretty_json("\n".join(lines)) or [f"\033[33m{line}\033[39m" for line in lines]
    label = [f"{DIM}{language}{UNDIM}"] if language else []
    return label + [f"{DIM}│{UNDIM} {line}" for line in body]


def markdown_line(line, width):
    if not line.strip():
        return ""
    heading = HEADING.match(line)
    if heading:
        underline = "\033[4m" if len(heading.group(1)) <= 2 else ""
        return f"{BOLD}{underline}{inline(heading.group(2))}\033[0m"
    if RULE.match(line):
        return f"{DIM}{'─' * min(width, 60)}{UNDIM}"
    quote = QUOTE.match(line)
    if quote:
        return f"{DIM}│{UNDIM} {inline(quote.group(1))}"
    bullet = BULLET.match(line)
    if bullet:
        return f"{bullet.group(1)}• {inline(bullet.group(2))}"
    if line.lstrip().startswith("|"):
        if TABLE_SEPARATOR.match(line):
            return f"{DIM}{line}{UNDIM}"
        return f"{DIM}│{UNDIM}".join(inline(cell) for cell in line.split("|"))
    return inline(line)


def render_message(text, width):
    whole = pretty_json(text)
    if whole:
        return whole
    rendered, code, language, fenced = [], [], "", False
    for line in text.split("\n"):
        line = CONTROL.sub(" ", line.replace("\t", "    "))
        fence = FENCE.match(line)
        if fence and not fenced:
            fenced, code, language = True, [], fence.group(2)
            continue
        if fence and fenced:
            rendered += code_block(code, language)
            fenced = False
            continue
        if fenced:
            code.append(line)
        else:
            rendered.append(markdown_line(line, width))
    if fenced:
        rendered += code_block(code, language)
    return rendered


def preview(session_id, focus, query):
    width = max(20, int(os.environ.get("FZF_PREVIEW_COLUMNS") or 80) - 2)
    db, _ = connect()
    session = db.execute(SESSION_SQL, (session_id,)).fetchone()
    if not session:
        print("Session not found.")
        return
    directory, title, project = session
    rows = [(seq, created, kind, text) for _, seq, created, kind, text in messages(db, [session_id])
            if text and text.strip()]
    highlight = highlighter(query)
    terms = query_terms(query)
    out = [f"{BOLD}{clean(title) or 'untitled'}{UNDIM}",
           f"{DIM}{clean(project_name(project, directory))} · {clean(directory)}{UNDIM}", ""]
    index = next((position for position, row in enumerate(rows) if str(row[0]) == focus), None)
    start = max(0, index - 1) if index is not None else 0
    if start:
        out.append(f"{DIM}··· {start} earlier message{'s' if start != 1 else ''}{UNDIM}")
        out.append("")
    shown = start
    for position in range(start, len(rows)):
        if len(out) >= PREVIEW_LINES:
            break
        seq, created, kind, text = rows[position]
        focused = position == index
        mark = "\033[35m▌\033[39m " if focused else "  "
        out.append(f"{mark}{speaker(kind)}  {DIM}{when(created)}{UNDIM}")
        body = render_message(text, width)
        if index is not None and position < index and len(body) > CONTEXT_LINES:
            body = [f"{DIM}···{UNDIM}"] + body[-CONTEXT_LINES:]
        elif focused and terms:
            first = match_line(body, terms)
            skipped = max(0, first - 2)
            if skipped:
                body = [f"{DIM}··· {skipped} line{'s' if skipped != 1 else ''} before the match{UNDIM}"] + body[skipped:]
        if len(body) > MESSAGE_LINES:
            hidden = len(body) - MESSAGE_LINES
            body = body[:MESSAGE_LINES] + [f"{DIM}··· {hidden} more lines{UNDIM}"]
        out += [mark + highlight(line) for line in body]
        out.append("")
        shown = position + 1
    if shown < len(rows):
        remaining = len(rows) - shown
        out.append(f"{DIM}··· {remaining} later message{'s' if remaining != 1 else ''}{UNDIM}")
    sys.stdout.buffer.write(("\n".join(out) + "\n").encode("utf-8", "replace"))


def require_fzf():
    fzf = shutil.which("fzf")
    if not fzf:
        die("fzf not found")
    version = subprocess.run([fzf, "--version"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True).stdout
    match = re.match(r"(\d+)\.(\d+)", version)
    if match and (int(match.group(1)), int(match.group(2))) < MINIMUM_FZF:
        die(f"fzf {'.'.join(map(str, MINIMUM_FZF))} or newer is required; found {version.split()[0]}")


def fzf_command(query, sessions_mode):
    program = f"{shlex.quote(sys.executable)} {shlex.quote(SELF)}"
    preview_command = f"{program} __preview {{1}} {{3}} {{q}}"
    command = [
        "fzf", "--read0", "--print0", "--ansi", "--delimiter", "\t", "--with-nth", "4",
        "--query", query, "--layout", "reverse", "--highlight-line", "--info", "inline-right",
        "--preview", preview_command,
        "--preview-window", "right,50%,wrap,border-left,<80(down,55%,wrap,border-top)",
        "--bind", "ctrl-/:toggle-preview", "--expect", "ctrl-y",
    ]
    if sessions_mode:
        return command + [
            "--scheme", "history", "--prompt", "sessions> ",
            "--header", "Enter resume · Ctrl-Y print id · Ctrl-/ preview",
        ]
    reload = f"reload({program} __search {{q}})"
    return command + [
        "--disabled", "--gap", "--prompt", "chat> ",
        "--bind", f"start:{reload}", "--bind", f"change:{reload}", "--bind", f"ctrl-r:{reload}",
        "--bind", f"result:transform-header({program} __status)",
    ]


def resume(output):
    parts = output.decode("utf-8", "replace").split("\0")
    key = parts[0]
    selected = parts[1] if len(parts) > 1 else ""
    if not selected:
        return
    fields = selected.split("\t")
    session_id = fields[0]
    directory = fields[1] if len(fields) > 1 else ""
    if not session_id:
        return
    if key == "ctrl-y":
        print(session_id)
        return
    home = os.path.expanduser("~")
    if directory and os.path.isdir(directory):
        target = directory
    else:
        if directory:
            print(f"ocg: directory {directory} missing; resuming from {home}", file=sys.stderr)
        target = home
    os.chdir(target)
    os.environ["PWD"] = target
    os.execvp("opencode", ["opencode", "--session", session_id])


def pick(query, sessions_mode):
    require_fzf()
    db, database = connect()
    cache = Cache(database)
    sessions = load_sessions(db)
    if sessions_mode:
        items = session_items(sessions)
        db.close()
        picked = subprocess.run(fzf_command(query, True), input=items.encode("utf-8", "replace"),
                                stdout=subprocess.PIPE)
    else:
        cache.write_index(sessions)
        fill(db, cache, sessions, limit=setting("OCG_EAGER", 50, int))
        db.close()
        with tempfile.TemporaryFile() as errors:
            loader = subprocess.Popen([sys.executable, SELF, "__load"], stdout=subprocess.DEVNULL,
                                      stderr=errors, preexec_fn=lambda: os.nice(10))
            try:
                picked = subprocess.run(fzf_command(query, False), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
            finally:
                loader.terminate()
                loader.wait()
            errors.seek(0)
            sys.stderr.write(errors.read().decode("utf-8", "replace"))
    if picked.returncode == 0:
        resume(picked.stdout)


def main(argv):
    os.umask(0o077)
    command = argv[0] if argv else ""
    if command == "__load":
        load()
        return
    if command == "__search":
        try:
            search(argv[1] if len(argv) > 1 else "")
        except BrokenPipeError:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        return
    if command == "__status":
        status()
        return
    if command == "__preview":
        arguments = argv[1:] + ["", "", ""]
        preview(arguments[0], arguments[1], arguments[2])
        return
    if command in ("-h", "--help"):
        print(__doc__.strip())
        return
    sessions_mode = command in ("-s", "--sessions")
    pick(" ".join(argv[1:] if sessions_mode else argv), sessions_mode)


if __name__ == "__main__":
    main(sys.argv[1:])
